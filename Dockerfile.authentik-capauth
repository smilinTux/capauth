# ──────────────────────────────────────────────────────────────────────
#  Custom Authentik image with CapAuth PGP passwordless stage
#  Adds: Python backend (Django app) + Lit web component (frontend)
#
#  Build:
#    docker build -f Dockerfile.authentik-capauth \
#      -t skgit.skstack01.douno.it/skadmin/authentik-capauth:2025.12.6 \
#      -t skgit.skstack01.douno.it/skadmin/authentik-capauth:latest .
#
#  Push:
#    docker push skgit.skstack01.douno.it/skadmin/authentik-capauth:2025.12.6
#    docker push skgit.skstack01.douno.it/skadmin/authentik-capauth:latest
#
#  AK_VERSION tracks the latest STABLE Authentik release (override with --build-arg).
#
#  2026-10-23 (Chef decision, tactical patch): pinned to 2025.12.6, the latest
#  2025.12.x patch, same major line as nor prod's running 2025.12.3. This is the
#  SAME-LINE security patch (fixes GHSA-xp7f-xjjx-gwm8 Critical SourceStage bypass
#  and GHSA-c3m2-jqmq-pvp3 SAML XML signature wrapping), not the full 2026.8.5
#  migration. The 2025.12.x line does not receive the later privilege-escalation
#  (GHSA-h6c5-mpvq-j4jc) or SAML-DoS (GHSA-cxwx-9x59-28qm) backports -- those land
#  only with the full upgrade (see docs/AUTHENTIK_STRATEGY_DECISION.md, option b,
#  decision 2026-10-23: retire this fork for CAPAUTH_ENABLED on stock Authentik as
#  part of that upgrade).
# ──────────────────────────────────────────────────────────────────────
ARG AK_VERSION=2025.12.6

# ── Stage 1: Rebuild Authentik frontend with ak-stage-capauth ────────
FROM node:24-bookworm AS web-builder

ARG AK_VERSION
WORKDIR /build

# Clone Authentik source (shallow, single branch)
RUN apt-get update && apt-get install -y --no-install-recommends git && \
    git clone --depth 1 --branch version/${AK_VERSION} \
      https://github.com/goauthentik/authentik.git /build/authentik && \
    rm -rf /build/authentik/.git

WORKDIR /build/authentik/web

# Install web dependencies with `npm ci` so we get the EXACT versions Authentik's
# lockfile pins. `npm install` resolves newer minor versions (notably of Lit), which
# breaks esbuild's chunk splitting at runtime — the built bundle ends up with a chunk
# that imports `createRef` from a sibling chunk that doesn't re-export it
# ("does not provide an export named 'createRef'"), so the whole SPA fails to boot
# (live-proven on .13: blank loading spinner, backend/API fine). Our CapAuth component
# only uses deps Authentik already ships, so `npm ci` needs no lockfile regeneration.
RUN npm ci --ignore-engines 2>&1 || npm install --ignore-engines 2>&1

# Copy CapAuth stage web component into the Authentik web tree
COPY web/stages/capauth/ /build/authentik/web/src/flow/stages/capauth/

# Register the component in the flow entrypoint
RUN echo '' >> src/flow/index.entrypoint.ts && \
    echo '// CapAuth PGP passwordless stage' >> src/flow/index.entrypoint.ts && \
    echo 'import "#flow/stages/capauth/CapAuthStage";' >> src/flow/index.entrypoint.ts

# Build the frontend (esbuild via npm run build)
RUN npm run build

# ── Stage 2: Final custom Authentik image ────────────────────────────
FROM ghcr.io/goauthentik/server:${AK_VERSION}

USER root

# Install capauth into Authentik's venv. Most deps (pydantic, httpx, click, …) already exist
# there; only PGPy is missing. The venv's Python MINOR changes across Authentik releases
# (2026.5.x → py3.14, earlier → py3.13), so detect the real site-packages dir at build time
# instead of hardcoding it — otherwise capauth lands on the wrong path and Django can't import
# it (ModuleNotFoundError: capauth, live-proven on .13 against 2026.5.3).
COPY . /app/capauth
# capauth's pyproject.toml uses setuptools_scm (dynamic version from git tags),
# but .dockerignore excludes .git from the build context, so `pip install
# /app/capauth` cannot infer a version and fails with "setuptools-scm was
# unable to detect version" (hit rebuilding this image 2026-10-23, unrelated
# to the AK_VERSION bump -- would fail the same way at any Authentik version
# until this is set). Pin it explicitly to the latest released tag.
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_CAPAUTH=0.3.13
RUN VENV_SP="$(ls -d /ak-root/.venv/lib/python3.*/site-packages | head -1)" && \
    echo "Installing capauth into $VENV_SP" && \
    pip install --no-cache-dir --no-deps --target "$VENV_SP" /app/capauth && \
    pip install --no-cache-dir --target "$VENV_SP" PGPy && \
    # PGPy 0.6.0 does `import imghdr`, a stdlib module removed in Python 3.13 (PEP 594).
    # Authentik 2026.5.x runs on py3.14, so without a backport the CapAuth PGP crypto
    # backend fails to import at runtime (live-proven on .13). Vendor a faithful shim.
    cp /app/capauth/authentik-custom/imghdr.py "$VENV_SP/imghdr.py" && \
    PYTHONPATH="$VENV_SP" python3 -c "import imghdr; assert hasattr(imghdr,'what'); print('imghdr shim OK')"

# NOTE: the from-source web rebuild (web-builder stage) is DISABLED. Building Authentik's
# web bundle with `npm run build` hits an esbuild code-splitting bug — a shared chunk defines
# `createRef` (Lit) but doesn't re-export it across the chunk boundary, so the runtime SPA
# throws "does not provide an export named 'createRef'" and never boots (blank spinner;
# identical output under npm ci AND npm install, so it's not version drift — it's the
# from-source build itself). Authentik's OFFICIAL image ships a correctly pre-built bundle,
# so we keep the stock /web/dist. Trade-off: the `ak-stage-capauth` browser web component is
# absent, so the PGP login *form* won't render in-browser — but the CapAuth backend stage and
# its flow-executor API work fully (passwordless PGP auth is API-proven). Re-enable this COPY
# only once the from-source web build is fixed (correct esbuild chunking for the custom stage).
# COPY --from=web-builder /build/authentik/web/dist/ /web/dist/

# Add Django app registration via Authentik's user_settings hook
# Authentik loads this at startup: _update_settings("data.user_settings")
COPY authentik-custom/user_settings.py /data/user_settings.py

# NB: NO custom /lifecycle/system_migrations/capauth_migrate.py. user_settings.py registers
# capauth in TENANT_APPS, so Authentik's normal `ak migrate` already migrates the capauth app
# in dependency order. The old system-migration ran `ak migrate capauth` TOO EARLY — before the
# base schema existed — which failed on a FRESH DB ("relation authentik_version_history does not
# exist", live-proven on .13). Letting the standard migrate handle it is fresh-DB-safe.

# Fix permissions (authentik runs as uid 1000)
RUN chown 1000:1000 /data/user_settings.py && \
    chmod 644 /data/user_settings.py

USER authentik
