# ──────────────────────────────────────────────────────────────────────
#  Custom Authentik image with CapAuth PGP passwordless stage
#  Adds: Python backend (Django app) + Lit web component (frontend)
#
#  Build (cap10 restores the from-source ak-stage-capauth web component — PGP login works
#  in a BROWSER again; cap9 had shipped the stock frontend without it):
#    docker build -f Dockerfile.authentik-capauth \
#      -t ghcr.io/smilintux/authentik-capauth:2026.5.3-cap10 \
#      -t ghcr.io/smilintux/authentik-capauth:2026.5.3 \
#      -t ghcr.io/smilintux/authentik-capauth:latest .
#
#  Push:
#    docker push ghcr.io/smilintux/authentik-capauth:2026.5.3-cap10
#    docker push ghcr.io/smilintux/authentik-capauth:2026.5.3
#    docker push ghcr.io/smilintux/authentik-capauth:latest
#
#  AK_VERSION tracks the latest STABLE Authentik release (override with --build-arg).
# ──────────────────────────────────────────────────────────────────────
ARG AK_VERSION=2026.5.3

# ── Stage 1: Rebuild Authentik frontend with ak-stage-capauth ────────
FROM node:24-bookworm AS web-builder

ARG AK_VERSION
WORKDIR /build

# Clone Authentik source (shallow, single branch)
RUN apt-get update && apt-get install -y --no-install-recommends git && \
    git clone --depth 1 --branch version/${AK_VERSION} \
      https://github.com/goauthentik/authentik.git /build/authentik && \
    rm -rf /build/authentik/.git

WORKDIR /build/authentik/web

# Install web dependencies with `npm ci` (NOT `npm install`). `npm ci` installs the EXACT
# versions Authentik's committed lockfile pins, which guarantees a SINGLE `lit` / `lit-html`
# instance in node_modules. `npm install` is free to resolve newer minor versions and can pull
# a SECOND copy of `lit-html` — and because Authentik's own source mixes `import … from "lit"`
# and `import … from "lit-html"` (35 files), two `lit-html` identities split the `createRef`/
# `ref` directive across esbuild chunks. With `splitting:true` the minified prod bundle then
# emits a chunk that imports `createRef` (minified `e`) from a sibling chunk that doesn't
# re-export it → runtime "does not provide an export named 'createRef'" → blank SPA. `npm ci`
# against the pinned lockfile (one lit-html@3.x) does NOT trigger this; the from-source build
# is clean (verified: 0 missing cross-chunk exports across the minified prod dist, cap10).
# Our CapAuth component only uses deps Authentik already ships, so no lockfile regeneration.
RUN npm ci --ignore-engines 2>&1

# Copy CapAuth stage web component into the Authentik web tree
COPY web/stages/capauth/ /build/authentik/web/src/flow/stages/capauth/

# Register the component in the flow entrypoint
RUN echo '' >> src/flow/index.entrypoint.ts && \
    echo '// CapAuth PGP passwordless stage' >> src/flow/index.entrypoint.ts && \
    echo 'import "#flow/stages/capauth/CapAuthStage";' >> src/flow/index.entrypoint.ts

# Build the frontend. NODE_ENV=production matches the OFFICIAL Authentik image build
# (minified bundle), so the resulting /web/dist is a drop-in replacement for the stock one.
# `build` emits admin/user/flow/rac/standalone/styles/poly + chunks; `build:sfe` emits the
# legacy Simple-Flow-Executor (dist/sfe) that the stock image also ships — together they make
# the rebuilt /web/dist complete (only diff vs stock is the added ak-stage-capauth component).
RUN NODE_ENV=production npm run build && \
    NODE_ENV=production npm run build:sfe && \
    test -f dist/sfe/index.js && \
    grep -rl ak-stage-capauth dist/flow >/dev/null && echo "✅ ak-stage-capauth present in /web/dist/flow"

# ── Stage 2: Final custom Authentik image ────────────────────────────
FROM ghcr.io/goauthentik/server:${AK_VERSION}

USER root

# Install capauth into Authentik's venv. Most deps (pydantic, httpx, click, …) already exist
# there; only PGPy is missing. The venv's Python MINOR changes across Authentik releases
# (2026.5.x → py3.14, earlier → py3.13), so detect the real site-packages dir at build time
# instead of hardcoding it — otherwise capauth lands on the wrong path and Django can't import
# it (ModuleNotFoundError: capauth, live-proven on .13 against 2026.5.3).
COPY . /app/capauth
RUN VENV_SP="$(ls -d /ak-root/.venv/lib/python3.*/site-packages | head -1)" && \
    echo "Installing capauth into $VENV_SP" && \
    pip install --no-cache-dir --no-deps --target "$VENV_SP" /app/capauth && \
    pip install --no-cache-dir --target "$VENV_SP" PGPy && \
    # PGPy 0.6.0 does `import imghdr`, a stdlib module removed in Python 3.13 (PEP 594).
    # Authentik 2026.5.x runs on py3.14, so without a backport the CapAuth PGP crypto
    # backend fails to import at runtime (live-proven on .13). Vendor a faithful shim.
    cp /app/capauth/authentik-custom/imghdr.py "$VENV_SP/imghdr.py" && \
    PYTHONPATH="$VENV_SP" python3 -c "import imghdr; assert hasattr(imghdr,'what'); print('imghdr shim OK')"

# Install the rebuilt frontend that INCLUDES the ak-stage-capauth web component (cap10).
# cap9 shipped the stock /web/dist because an earlier from-source attempt hit the esbuild
# code-splitting bug (a chunk imports `createRef`/`e` that a sibling chunk doesn't re-export
# → blank SPA). Root cause was a SECOND `lit-html` copy from `npm install`; building with
# `npm ci` against the pinned lockfile keeps a single lit-html and the bug does NOT occur.
# The web-builder stage's prod (minified) dist was verified to have 0 missing cross-chunk
# exports AND to contain ak-stage-capauth, so we restore the from-source /web/dist here.
# Without this COPY the flow executor cannot render the PGP challenge in a browser.
COPY --from=web-builder /build/authentik/web/dist/ /web/dist/

# Add Django app registration via Authentik's user_settings hook
# Authentik loads this at startup: _update_settings("data.user_settings")
COPY authentik-custom/user_settings.py /data/user_settings.py

# Bake the CapAuth PGP-login blueprint into the image. Authentik's WORKER auto-discovers and
# applies *.yaml under /blueprints/ on startup, so every install gets the CapAuthStage instance
# + a "CapAuth PGP Login" authentication flow out of the box (label
# blueprints.goauthentik.io/instantiate: "true"). The capauth app is registered in TENANT_APPS
# (user_settings.py) and its API URLs are auto-mounted via capauth/urls.py:api_urlpatterns, so
# the stage is also admin/API-manageable at /api/v3/stages/capauth/.
COPY src/capauth/authentik/blueprints/capauth-pgp-login.yaml /blueprints/capauth/capauth-pgp-login.yaml

# NB: NO custom /lifecycle/system_migrations/capauth_migrate.py. user_settings.py registers
# capauth in TENANT_APPS, so Authentik's normal `ak migrate` already migrates the capauth app
# in dependency order. The old system-migration ran `ak migrate capauth` TOO EARLY — before the
# base schema existed — which failed on a FRESH DB ("relation authentik_version_history does not
# exist", live-proven on .13). Letting the standard migrate handle it is fresh-DB-safe.

# Fix permissions (authentik runs as uid 1000)
RUN chown 1000:1000 /data/user_settings.py && \
    chmod 644 /data/user_settings.py && \
    chown -R 1000:1000 /blueprints/capauth && \
    chmod 644 /blueprints/capauth/capauth-pgp-login.yaml

USER authentik
